{
  "name": "@peephole/extension",
  "description": "",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"wxt,helium\" -c \"blue,cyan\" \"wxt\" \"node ./scripts/open-dual-helium.mjs\"",
